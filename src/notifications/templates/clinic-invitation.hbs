<div style="font-family: 'Segoe UI', Arial, sans-serif; background-color: #f9f9f9; padding: 40px 10px;">
  <div style="max-width: 500px; margin: auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.1); border: 1px solid #e0e0e0;">
    
    <div style="background-color: #ffffff; padding: 20px; text-align: center; border-bottom: 1px solid #f0f0f0;">
      <h1 style="margin: 0; color: #27ae60; font-size: 24px;">Vet<span style="color: #2980b9;">Connect</span></h1>
    </div>

    <div style="padding: 20px; text-align: center;">
      <h2 style="color: #333; margin-bottom: 10px;">¡Invitación a Clínica!</h2>
      <p style="color: #666; font-size: 16px; margin-bottom: 25px;">
        La clínica <strong>{{clinicName}}</strong> te ha invitado a formar parte de su equipo médico.
      </p>
      
      <a href="{{inviteLink}}" style="display: inline-block; background-color: #27ae60; color: white; padding: 15px 25px; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 16px;">
        Aceptar Invitación
      </a>
    </div>

    <div style="background-color: #f8fafc; padding: 20px; font-size: 12px; color: #94a3b8; text-align: center;">
      <p style="margin: 5px 0;">Fecha: {{fecha}}</p>
      <div style="margin-top: 15px; border-top: 1px solid #e2e8f0; padding-top: 15px;">
        <p style="margin: 0;">© 2026 VetConnect - Tu salud animal, nuestra prioridad.</p>
      </div>
    </div>
  </div>
</div>